{
  "name": "@dtc/backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "seed": "medusa exec ./src/scripts/seed-commerce.ts",
    "seed:e2e": "medusa exec ./src/scripts/e2e-seed.ts",
    "seed:e2e-products": "medusa exec ./src/scripts/e2e-seed-products.ts",
    "cleanup:e2e-products": "medusa exec ./src/scripts/e2e-cleanup-products.ts",
    "benchmark:catalog-search": "medusa exec ./src/scripts/benchmark-catalog-search.ts",
    "probe:moysklad": "ts-node --transpile-only src/scripts/probe-standalone.ts",
    "lint": "medusa lint",
    "architecture:check": "node scripts/architecture-check.mjs",
    "architecture:write": "node scripts/architecture-check.mjs --write",
    "typecheck:admin": "tsc --noEmit -p src/admin/tsconfig.json",
    "test": "npm run test:unit",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:coverage": "COVERAGE=true TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:scripts": "node --test scripts/*.test.js scripts/*.test.mjs",
    "check": "npm run architecture:check && npm run lint && npm run test:unit && npm run build && npm run test:scripts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@gorgo/medusa-payment-yookassa": "^1.0.5",
    "@medusajs/admin-sdk": "2.17.2",
    "@medusajs/admin-shared": "2.17.2",
    "@medusajs/caching": "2.17.2",
    "@medusajs/cli": "2.17.2",
    "@medusajs/dashboard": "2.17.2",
    "@medusajs/draft-order": "2.17.2",
    "@medusajs/framework": "2.17.2",
    "@medusajs/medusa": "2.17.2",
    "@medusajs/ui": "4.1.19",
    "@tanstack/react-query": "5.64.2",
    "@types/nodemailer": "^8.0.1",
    "meilisearch": "^0.59.0",
    "nodemailer": "^9.0.3",
    "react-i18next": "13.5.0",
    "react-router-dom": "6.30.4",
    "sanitize-html": "2.17.5",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.17.2",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "@types/sanitize-html": "^2.16.1",
    "jest": "^29.7.0",
    "pg-god": "^1.0.12",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53",
    "@medusajs/eslint-plugin": "2.16.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "likec4": "1.59.4",
    "patch-package": "^8.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10.9.2"
}
