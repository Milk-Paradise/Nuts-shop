MEDUSA_ADMIN_ONBOARDING_TYPE=skip

STORE_CORS=http://localhost:9000,http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:7001
AUTH_CORS=http://localhost:9000,http://localhost:7001,http://localhost:8000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa_backend_v2
REDIS_URL=redis://localhost:6379
REDIS_RECONNECT_ATTEMPTS=5
REDIS_RECONNECT_DELAY_MS=1000
REDIS_RECONNECT_COOLDOWN_MS=30000
# TTL in seconds for public catalog lists (brands, category tree, promotions,
# and new arrivals). These responses never contain cart, customer, or auth data.
CATALOG_PUBLIC_LIST_CACHE_TTL_SECONDS=300

JWT_SECRET=change-me-local-jwt-secret
COOKIE_SECRET=change-me-local-cookie-secret
AUTH_MFA_ENCRYPTION_KEY=change-me-local-mfa-encryption-key
# One canonical base64-encoded 32-byte key for newly stored provider secrets.
SECRET_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output
# Legacy decryption only; retain until all stored provider secrets are migrated.
MOYSKLAD_ENCRYPTION_KEY=change-me-local-moysklad-encryption-key
MOYSKLAD_REQUEST_TIMEOUT_MS=30000
# Optional override for isolated test/e2e environments. When omitted, the
# client uses https://api.moysklad.ru/api/remap/1.2.
# MOYSKLAD_BASE_URL=http://127.0.0.1:19001/api/remap/1.2
SHIPPING_PROVIDER_CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Test/stage only. Production Ozon endpoints are intentionally rejected.
# OZON_API_BASE_URL=http://127.0.0.1:<ozon-test-stub-port>
# "shipment not found" responses. Temporary and ambiguous failures don't count.
PAYMENT_PROVIDER_CONFIG_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output
MEDUSA_FF_RBAC=true
# Host dev backend runs with NODE_ENV=development, so this has no effect locally;
# it matters once NODE_ENV=production (e.g. Docker Compose) without TLS in front.
SESSION_COOKIE_SECURE=false
# Comma-separated proxy CIDRs allowed to supply X-Forwarded-For for YooKassa webhooks.
# Keep empty when the backend is exposed directly.
YOOKASSA_WEBHOOK_TRUSTED_PROXY_CIDRS=

S3_ENDPOINT=http://localhost:9002
S3_BUCKET=auto-paint-store
S3_FILE_URL=http://localhost:9002/auto-paint-store
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Optional durable cache for normalized pickup-point catalog snapshots. It uses
# the S3 endpoint and credentials above, but a separate bucket is required so
# regular uploaded files and cache objects remain isolated. Leave unset to use
# the existing database path without caching.
# PVZ_SNAPSHOT_S3_BUCKET=pickup-point-snapshots
# PVZ_SNAPSHOT_S3_PREFIX=pvz-snapshots
# PVZ_SNAPSHOT_CACHE_TTL_MS=300000
# PVZ_SNAPSHOT_LOCK_WAIT_MS=5000
# PVZ_SNAPSHOT_LOCK_BACKOFF_MS=100
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your-meilisearch-api-key

# Transactional email (password reset, cart-abandonment reminder). Sending
# failures are logged and never throw — an unconfigured/unreachable SMTP
# server does not break registration, checkout, or any other flow.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASSWORD=change-me-smtp-password
SMTP_FROM=no-reply@example.com

# Base URL used to build links in transactional emails (password reset,
# cart-abandonment reminder). In production this should be the public URL
# the storefront is actually served from (same origin as the backend, see
# CLAUDE.md — storefront is served by the backend itself in prod).
STOREFRONT_URL=http://localhost:8000

# Required when the Telegram notification channel is enabled unless these
# values are stored with its encrypted credentials.
TELEGRAM_BOT_USERNAME=example_bot
TELEGRAM_WEBHOOK_SECRET=replace-with-telegram-webhook-secret
